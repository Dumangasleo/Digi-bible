{
  "expo": {
    "name": "Digi Bible",
    "slug": "SmartBible",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
     "updates": {
      "url": "https://u.expo.dev/8e885a36-6846-41ec-8d34-bafe06400c68"
    },
    "orientation": "portrait",
    "icon": "./assets/images/digi-bible-logo.png",
    "scheme": "smartbible",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "SmartBible uses speech recognition to transcribe your spoken notes.",
        "NSMicrophoneUsageDescription": "SmartBible uses the microphone to dictate your notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/digi-bible-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.leyd.SmartBible"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/images/digi-bible-logo.png",
          "imageWidth": 250
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SmartBible uses the microphone to dictate your notes.",
          "speechRecognitionPermission": "SmartBible uses speech recognition to transcribe your spoken notes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e885a36-6846-41ec-8d34-bafe06400c68"
      }
    }
  }
}
